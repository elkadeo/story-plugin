{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" SessionStart", "timeout": 15}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" UserPromptSubmit", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "TaskCreate|TaskUpdate", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" Checklist", "timeout": 15, "async": true}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" PostToolUse", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" Stop", "timeout": 15}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/story/hook.py\" SessionEnd", "timeout": 2}]}
    ]
  }
}
